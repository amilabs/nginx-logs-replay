{
  "name": "@amilabs/nginx-logs-replay",
  "version": "2.0.0",
  "description": "Replay nginx access logs with k6 and see where the time goes: per endpoint and per backend component",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/amilabs/nginx-logs-replay.git"
  },
  "keywords": [
    "replay",
    "nginx",
    "logs",
    "k6",
    "load-testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "discover": "k6 run src/discover.ts",
    "replay": "k6 run src/replay.ts"
  },
  "devDependencies": {
    "@types/k6": "^2.2.0",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
